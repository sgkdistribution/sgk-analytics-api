# ===========================================================================
# SGK ANALYTICS API
# Put the REAL values in Railway -> Variables. Never commit them, and never
# paste them into a chat, an email or a ticket.
# ===========================================================================

PORT=8080

# --- MySQL (Go2Stream WMS extract) -----------------------------------------
# Create a DEDICATED MySQL user for this service and grant it SELECT ONLY on
# this one database. It never writes anything, so it should not be able to.
#   CREATE USER 'sgk_analytics'@'%' IDENTIFIED BY '<a long random password>';
#   GRANT SELECT ON stream_data_extract_sgk.* TO 'sgk_analytics'@'%';
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_PORT=3306
# The connection crosses the public internet, so keep TLS on. Only set
# SQL_TRUST_CERT=true if the server uses a self-signed certificate, and even
# then it is better to fix the certificate.
SQL_ENCRYPT=true
SQL_TRUST_CERT=false

# Cloud SQL client certificates (mutual TLS). Set all three or none.
# The key is a CREDENTIAL: chmod 600, owned by the service user, never committed.
SQL_SSL_CA=/etc/sgk-analytics-ssl/server-ca.pem
SQL_SSL_CERT=/etc/sgk-analytics-ssl/client-cert.pem
SQL_SSL_KEY=/etc/sgk-analytics-ssl/client-key.pem
SQL_POOL_MAX=6
SQL_TIMEOUT_MS=20000

# --- Who is allowed in ------------------------------------------------------
# The portal's Cognito user pool. Tokens are verified against its public keys,
# so there is no shared secret to leak.
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# SGK staff: may view any company via ?company=<id>
SGK_DOMAINS=sgkhomedelivery.co.uk
SGK_EMAILS=
# Optional: a Cognito group name that also grants staff access
SGK_GROUP=

# Only these origins may call the service from a browser.
ALLOWED_ORIGINS=https://portal.sgkhomedelivery.co.uk,https://sgkhomedelivery.co.uk

# How long an identical query is reused before hitting SQL again.
CACHE_TTL_MS=45000

# --- WHICH ORDERS COUNT ------------------------------------------------------
# LEAVE THIS UNSET. Empty means every order is counted, which is how a Power BI
# report reads the same table — so the portal and Power BI reconcile to the
# penny.
#
# This used to default to "Cancelled" in code, which silently removed cancelled
# orders from every figure and made the portal disagree with Power BI in every
# month, for ever (1,597 orders and £2,118.60 on Roseland's 2026). It is now a
# deliberate, visible setting and /health says which way it is set.
#
# Only set it if you genuinely want cancelled orders left out AND you have
# changed the Power BI report to match:
#   SQL_ORDERS_EXCLUDE_STATUSES=Cancelled
SQL_ORDERS_EXCLUDE_STATUSES=

# --- HOW OFTEN GO2STREAM IS RE-READ ------------------------------------------
# The service refreshes every company's figures on a timer, whether anyone is
# looking or not, so the first person in each morning is not the one who pays
# for a cold cache. Default 30 minutes. 3600000 for hourly, 0 to turn the timer
# off and read on demand only.
REFRESH_EVERY_MS=1800000

# How old a cached answer may be before somebody has to wait for a rebuild.
# Defaults to twice REFRESH_EVERY_MS (minimum 15 minutes), which is deliberate:
# anything shorter leaves a gap at the end of each cycle where the timer has not
# fired yet but the cache has already aged out, and whoever opens the dashboard
# in that gap sits through the full cold rebuild the timer exists to prevent.
# CACHE_STALE_MS=3600000

# --- The company map --------------------------------------------------------
# Which signed-in people map to which WMS client key. THIS is the thing that
# keeps one client out of another's numbers, which is why it lives here on the
# server and not on a record the browser can touch. companyId must match the
# company id in the portal.
CLIENT_MAP=[{"companyId":"REPLACE_ME","name":"Roseland Furniture","sqlKey":"REPLACE_WITH_WMS_KEY","domains":["roselandfurniture.co.uk"],"emails":[]}]

# ===========================================================================
# SCHEMA MAPPING — the table and column names in your MySQL extract.
# Everything below is a GUESS based on the labels on the Power BI report.
# Run `npm run discover`, then correct these. Any that are already right can
# be deleted; queries.js falls back to the same defaults.
# ===========================================================================
SQL_ORDERS_TABLE=orders
SQL_ORDERS_CLIENT_COL=ClientCode
SQL_ORDERS_ID_COL=OrderId
SQL_ORDERS_VALUE_COL=OrderValue
SQL_ORDERS_WEIGHT_COL=WeightKg
SQL_ORDERS_CUBE_COL=CubeM3
SQL_ORDERS_ITEMS_COL=ItemCount
SQL_ORDERS_SERVICE_COL=ServiceLevelName
SQL_ORDERS_STATUS_COL=OrderStatus
SQL_ORDERS_COMPLETED_VALUE=Completed
SQL_ORDERS_CREATED_COL=CreatedDate
SQL_ORDERS_RECEIVED_COL=ReceivedDate
SQL_ORDERS_PROPOSED_COL=ProposedDate
SQL_ORDERS_DELIVERED_COL=DeliveredDate

SQL_ATTEMPTS_TABLE=delivery_attempts
SQL_ATTEMPTS_CLIENT_COL=ClientCode
SQL_ATTEMPTS_ORDER_COL=OrderId
SQL_ATTEMPTS_DATE_COL=AttemptDate
SQL_ATTEMPTS_STATUS_COL=AttemptStatus
SQL_ATTEMPTS_SUCCESS_VALUE=Successful
SQL_ATTEMPTS_FAIL_VALUE=Failed
SQL_ATTEMPTS_ONTIME_COL=OnTimeStatus
SQL_ATTEMPTS_ONTIME_VALUE=On Time
